# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# In production, set these same variables in the Vercel project settings.

# Neon Postgres connection string for the 2026/27 season database.
DATABASE_URL="YOUR_NEON_DATABASE_URL_HERE"

# Iron Session cookie encryption key. Must be at least 32 characters long.
# Generate one with: openssl rand -base64 32
SECRET_COOKIE_PASSWORD=

# Secret token that protects the cron standings-update endpoint.
# Any secure random string. Generate one with: openssl rand -base64 32
CRON_SECRET=
